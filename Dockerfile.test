FROM uselagoon/python-3.12:latest@sha256:5ab457220705f7b4c072ee746b5920779a385a70175e0471b9a263c840ff1070

WORKDIR /app

# Copy requirements files
COPY requirements.txt .
COPY requirements-test.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --require-hashes -r requirements.txt -r requirements-test.txt

# Copy application code, scripts, and tests
COPY app/ app/
COPY scripts/ scripts/
COPY tests/ tests/

# Set environment variables for testing
ENV PYTHONPATH=/app
ENV TESTING=1

# Command to run tests (integration suite runs separately via
# `make integration-test` against real LiteLLM instances)
CMD ["pytest", "-v", "--ignore=tests/integration", "tests/"]