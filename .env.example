SSL_SECURITY_LEVEL="DEFAULT@SECLEVEL=1"
ENABLE_LIMITS="true"
# JWT signing secret. Must be >=32 chars and not a known default.
# Generate one with: openssl rand -hex 32
AMAZEEAI_JWT_SECRET="CHANGE_ME_run_openssl_rand_hex_32_to_generate"
# Fernet keys for the model registry credential values, comma separated; the first one encrypts.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REGISTRY_CREDENTIAL_KEYS=""
