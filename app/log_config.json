{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": { "()": "app.json_log.JsonFormatter" }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    }
  },
  "root": { "level": "INFO", "handlers": ["stdout"] }
}
